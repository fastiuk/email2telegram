[Mail]
# IMAP user
user: {{ IMAP_USER }}
# IMAP password
password: {{ IMAP_PASSWORD }}

# IMAP server
server: {{ IMAP_SERVER }}
# IMAP port (default: 993)
{% if IMAP_PORT %}
port: {{ IMAP_PORT }}
{% endif %}
# IMAP connection timout in seconds (default: 60)
#timeout: 60

# use timer in seconds (default: 10)
{% if IMAP_REFRESH %}
refresh: {{ IMAP_REFRESH }}
{% endif %}

# disconnect after each loop, not recommended for short refresh rates: [True|False]
#disconnect: False

# IMAP folder on server to check (default: INBOX)
{% if IMAP_FOLDER %}
folder: {{ IMAP_FOLDER }}
{% endif %}

# This is from IMAP, "ALL" is also useful. Check IMAP specs for more info.
# Placeholder "${lastUID}" is used to process new mails only (since last loop)
# Ex.:
# UID:                                      Mail ID on server
# UNSEEN:                                   Unseen mails, and mark them as seen
# HEADER <header field> "<search string>":  Search mails by header
{% if IMAP_SEARCH %}
search: {{ IMAP_SEARCH }}
{% elif MAIL_SUBJECT %}
search: (UID ${lastUID}:* UNSEEN HEADER Subject "{{ MAIL_SUBJECT | replace('\\', '\\\\') | replace('"', '\\"') }}")
{% else %}
search: (UID ${lastUID}:* UNSEEN)
{% endif %}

# Read mails received before application was started (default: False)
read_old_mails: {{ READ_OLD_MAILS | default('False', true) }}

# max length (characters) of forwarded mail content (default: 2000)
{% if MAX_LENGTH %}
max_length: {{ MAX_LENGTH }}
{% endif %}

# ignore inline image by regular expression, ex.: (spacer\.gif)
{% if IGNORE_INLINE_IMAGE %}
ignore_inline_image: {{ IGNORE_INLINE_IMAGE }}
{% endif %}

# Cut string from subject. Useful for automations with the same subject prefix.
# Usually, you don't like to see those prefixes. Plain text, not a regular expression.
{% if CUT_FROM_SUBJECT %}
cut_from_subject: {{ CUT_FROM_SUBJECT }}
{% endif %}


[Telegram]
# from @BotFather: Like "<Bot ID:Key>"
bot_token: {{ TELEGRAM_BOT_TOKEN }}
# ID of TG chat or user (<ID>, ex.: 123456) who gets forwarded messages.
# ID can be found by @myidbot (Bot commands: /start + /getid)
forward_to_chat_id: {{ TELEGRAM_CHAT_ID }}

# markdown version: [1|2]
#markdown_version: 2

# Prefers HTML Content over plain text part of mail and send HTML formatted messages to Telegram: [True|False]
{% if PREFER_HTML %}
prefer_html: {{ PREFER_HTML }}
{% endif %}

# forward mail content (text), otherwise only images/attachments with the subject as caption: [True|False]
forward_mail_content: {{ FORWARD_MAIL_CONTENT | default('True', true) }}
# forward attachments: [True|False]
{% if FORWARD_ATTACHMENT %}
forward_attachment: {{ FORWARD_ATTACHMENT }}
{% endif %}
# forward embedded images: [True|False]
{% if FORWARD_EMBEDDED_IMAGES %}
forward_embedded_images: {{ FORWARD_EMBEDDED_IMAGES }}
{% endif %}
